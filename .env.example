# Copie para .env (não commitado). Os valores abaixo batem com o docker-compose.yml.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://healthprior:healthprior@localhost:5432/healthprior

# Notificações ao paciente (DEMO). Padrão: simulado (nada é enviado). Para o Twilio (conta de teste):
# HP_NOTIFICA_CANAL=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=coloque_aqui_o_token
# ...ou, no lugar do token principal, uma API Key (recomendado); o ACCOUNT_SID continua sendo o AC...:
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=coloque_aqui_o_secret
# TWILIO_FROM=+1xxxxxxxxxx           # SMS: número do Twilio. WhatsApp (sandbox): whatsapp:+14155238886
# HP_NOTIFICA_DESTINO=+55xxxxxxxxxxx # SEU número (verificado no SMS; no WhatsApp, o que mandou "join ..." ao sandbox)
# TWILIO_SMS_TEMPLATE=sms_event_notifications  # conta de teste enviando SMS ao Brasil: só modelos pré-definidos (o Body é o nome)
# HP_NOTIFICA_LIMITE_ENVIO=5         # máximo de envios por rodada
# HP_NOTIFICA_MIN_POSICOES=20        # só avisa quem mudou tantas posições
# HP_NOTIFICA_MAX_POR_PUBLICACAO=3   # e no máximo tantos por publicação
